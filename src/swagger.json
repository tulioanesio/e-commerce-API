{
  "openapi": "3.0.0",
  "info": {
    "title": "Empire Store API",
    "version": "1.0.0",
    "description": "Full Stack API for an e-commerce application using Node.js, Express, and PostgreSQL (Prisma ORM).",
    "contact": {
      "email": "tulioluv@gmail.com"
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Authentication"
      }
    },
    "schemas": {
      "AuthInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": ["email", "password"]
      },
      "RegisterInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": ["username", "email", "password"]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "float"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "productId": {
            "type": "integer"
          },
          "quantity": {
            "type": "integer"
          },
          "total": {
            "type": "number"
          }
        }
      }
    }
  },
  "paths": {
    "/register": {
      "post": {
        "tags": ["Auth & Users"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered and authenticated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (Invalid data)."
          },
          "409": {
            "description": "Imperial ID (Email) already registered."
          },
          "500": {
            "description": "Server error!"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Auth & Users"],
        "summary": "Login an existing user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful! Token returned via cookie or response body."
          },
          "401": {
            "description": "Incorrect access code (password)."
          },
          "404": {
            "description": "User not found!"
          },
          "500": {
            "description": "Error when logging in"
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["Auth & Users"],
        "summary": "Get current user information (Requires Auth)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User information retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (Missing or invalid token)."
          }
        }
      }
    },
    "/logout": {
      "get": {
        "tags": ["Auth & Users"],
        "summary": "Logout the current user (clears token/cookie)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout successful."
          }
        }
      }
    },
    "/home": {
      "get": {
        "tags": ["Products"],
        "summary": "Get the home page data or featured products",
        "responses": {
          "200": {
            "description": "List of featured products.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/product/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product by ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Product ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Product retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Product not found."
          }
        }
      }
    },
    "/cart": {
      "get": {
        "tags": ["Cart"],
        "summary": "Get cart items (Requires Auth)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of items in the cart.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CartItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cart/{id}": {
      "post": {
        "tags": ["Cart"],
        "summary": "Add or update item quantity in cart by Product ID (Requires Auth)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "ID of the product to be added/updated."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Desired quantity. If omitted, may add 1."
                  }
                },
                "required": ["quantity"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item added/updated in the cart."
          },
          "400": {
            "description": "Invalid quantity or product ID."
          }
        }
      },
      "delete": {
        "tags": ["Cart"],
        "summary": "Remove cart item by ID (Requires Auth)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "ID of the cart item (or product ID, depending on your route)."
          }
        ],
        "responses": {
          "200": {
            "description": "Item successfully removed from cart."
          },
          "404": {
            "description": "Item not found in cart."
          }
        }
      }
    },
    "/checkout": {
      "get": {
        "tags": ["Cart"],
        "summary": "Get checkout information before payment (Requires Auth)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Checkout information retrieved successfully."
          },
          "400": {
            "description": "Cart is empty or payment details are missing."
          }
        }
      }
    },
    "/clear": {
      "delete": {
        "tags": ["Cart"],
        "summary": "Clear the entire cart (Requires Auth)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cart successfully cleared."
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
